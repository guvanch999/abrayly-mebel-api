# Copy to .env and adjust. The service reads the process environment;
# a .env file in the working directory is loaded automatically.
# docker compose reads the same file for variable substitution.

# --- Runtime ---------------------------------------------------------------
# "development" enables SQL query logging and a localhost Swagger host.
# Anything else (default: production) uses APP_URL as the Swagger host.
GO_ENV=development
PORT=3030
# Public base URL in production, e.g. https://api.example.com
APP_URL=
# Comma-separated list of allowed origins, or * for any.
CORS_ALLOWED_ORIGINS=*

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=abrayly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abrayly
# disable | require | verify-ca | verify-full
POSTGRES_SSLMODE=disable
# false = create the uuid-ossp extension, run GORM auto-migrations and seed
# the first admin on start-up. Defaults to true (migrations off) when unset.
DISABLE_AUTO_MIGRATION=false

# --- Admin authentication ----------------------------------------------------
# Two different random secrets, e.g. generated with: openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-access-token-secret
ADMIN_REFRESH_SECRET=change-me-refresh-token-secret

# --- First admin account -----------------------------------------------------
# Created only when auto-migration is enabled and the admins table is empty.
# If ADMIN_PASSWORD is empty, seeding is skipped with a warning.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
